{
  "guardian-approve-for-me": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/guardian_engine.js",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
